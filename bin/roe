#!/usr/bin/env bash
# roe — the remote_opencode_sync command front-end.
# One short command for every toolkit script, so you never have to remember the
# paths under ~/.local/share/remote_opencode_sync/scripts/... again.
#
#   roe help | version | update | setup | new | adopt | uninstall
#   roe status | pull | push | upgrade | track | history | model | desync | resync
#
# roe is installed as a symlink in ~/.local/bin pointing at this file. Because it
# resolves itself via readlink -f, it always runs the toolkit it came from (even
# across the symlink), and the scripts it dispatches stay current through `roe
# update`.

set -u

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$(dirname "$SELF")")"
SCRIPTS="$ROOT/scripts"

# shellcheck source=lib.sh
source "$SCRIPTS/lib.sh" 2>/dev/null || true  # needed for the 'model' subcommand

SC_UPDATE="$SCRIPTS/update.sh"
SC_SETUP="$SCRIPTS/setup-machine.sh"
SC_UNINSTALL="$SCRIPTS/uninstall.sh"
SC_NEW="$SCRIPTS/new-project.sh"
SC_PROJECTS="$SCRIPTS/projects.sh"
SC_DESYNC="$SCRIPTS/desync.sh"
SC_RESYNC="$SCRIPTS/resync.sh"
SC_STATUS="$SCRIPTS/status.sh"
SC_PULL="$SCRIPTS/pull.sh"
SC_PUSH="$SCRIPTS/push.sh"
SC_UPGRADE="$SCRIPTS/upgrade.sh"
SC_TRACK="$SCRIPTS/track.sh"
SC_HISTORY="$SCRIPTS/history.sh"

usage() {
  cat <<EOF
roe — the remote_opencode_sync command front-end (toolkit at $ROOT)

Usage: roe <command> [args...]

Commands:
  help                 show this help
  version              show installed + latest release (hints 'roe update' if behind)
  update               update the toolkit to the latest release
  setup | machine      one-time machine setup (prereqs, gh auth, ssh key, identity)
  new <name> [--setup] create & push a new project, then opencode into it
  adopt <dir> [args]   turn an existing local project into a synced project
  projects [name...]   list your GitHub projects that carry sync support (alias: list)
  clone <name>         clone a synced project onto this machine
  model [id]           show the project's pinned model; with id, change it
  status [dir]         is this a valid roe project, and what does it need (push/pull/upgrade)?
  pull [dir]           sync a project working copy with the latest round (fetch + rebase)
  push [dir]           push a project's committed state to its origin
  upgrade [dir]        refresh a project's sync layer to the current toolkit (non-destructive)
  track [dir]          see what a project syncs (tracked/untracked/ignored) and change it (TUI)
  history <sub> [dir]  archive / list / show this machine's session history for a project
  desync               stop THIS machine's copy of a project from syncing
  resync               undo desync (bring a copy back into the sync loop)
  uninstall [opts]     reverse the install (also removes the roe symlink + PATH line)

Run 'roe <command> --help' for script-specific options.
Aliases: create = new, list = projects
EOF
}

require() {
  if [[ -x "$1" ]]; then return 0; fi
  echo "roe: $1 is missing — this does not look like a valid toolkit install." >&2
  echo "     Reinstall with:" >&2
  echo "       curl -fsSL -o bootstrap.sh https://raw.githubusercontent.com/mwoh/remote_opencode_sync/main/scripts/bootstrap.sh" >&2
  echo "       && bash bootstrap.sh" >&2
  return 1
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" || "$cmd" == "help" ]]; then
    usage
    return 2
  fi
  shift

  case "$cmd" in
    version)
      local v latest vr
      v="$(git -C "$ROOT" describe --tags --abbrev=0 2>/dev/null)"
      [[ -n "$v" ]] || v="$(git -C "$ROOT" log -1 --format=%h 2>/dev/null || echo unknown)"
      echo "remote_opencode_sync $v"
      if latest="$(toolkit_latest_ver "$ROOT")"; then
        vr="$(ver_gt "$latest" "$v")"
        if [[ "$vr" == "1" ]]; then
          echo "  latest: $latest  -> update with: roe update"
        elif [[ "$latest" == "$v" ]]; then
          echo "  latest: $latest (up to date)"
        else
          echo "  latest: $latest (local is ahead of the latest release)"
        fi
      else
        echo "  latest: unknown (offline or no origin)"
      fi
      ;;
    update)      require "$SC_UPDATE"  && exec "$SC_UPDATE" "$@" ;;
    setup|machine) require "$SC_SETUP" && exec "$SC_SETUP" "$@" ;;
    uninstall)   require "$SC_UNINSTALL" && exec "$SC_UNINSTALL" "$@" ;;
    new|create)  require "$SC_NEW"     && exec "$SC_NEW" "$@" ;;
    adopt)       require "$SC_NEW"     && exec "$SC_NEW" --existing "$@" ;;
    projects|list) require "$SC_PROJECTS" && exec "$SC_PROJECTS" list "$@" ;;
    clone)       require "$SC_PROJECTS" && exec "$SC_PROJECTS" clone "$@" ;;
    desync)      require "$SC_DESYNC"  && exec "$SC_DESYNC" "$@" ;;
    resync)      require "$SC_RESYNC"  && exec "$SC_RESYNC" "$@" ;;
    status)      require "$SC_STATUS"  && exec "$SC_STATUS" "$@" ;;
    pull)        require "$SC_PULL"    && exec "$SC_PULL" "$@" ;;
    push)        require "$SC_PUSH"    && exec "$SC_PUSH" "$@" ;;
    upgrade)     require "$SC_UPGRADE" && exec "$SC_UPGRADE" "$@" ;;
    track)       require "$SC_TRACK"   && exec "$SC_TRACK" "$@" ;;
    history)     require "$SC_HISTORY" && exec "$SC_HISTORY" "$@" ;;
    model)
      local pinned pin_file
      if [[ $# -eq 0 ]]; then
        pinned="$(model_get "$PWD" || true)"
        if [[ -n "$pinned" ]]; then echo "$PWD -> $pinned"
        else echo "no model pinned in $PWD (pin one with: roe model <id>)"; fi
      elif [[ $# -eq 1 ]]; then
        pin_file="$(model_set "$PWD" "$1")"
        echo "pinned model '$1' in $(basename "$pin_file") ($PWD)"
        echo "  propagate to every machine: git add $(basename "$pin_file") && git commit -m \"model: pin $1\" && git push"
      else
        echo "roe model: too many arguments" >&2
        return 2
      fi
      ;;
    *) echo "roe: unknown command: $cmd" >&2; usage >&2; return 2 ;;
  esac
}

main "$@"